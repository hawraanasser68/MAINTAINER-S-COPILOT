# Copy this file to .env and fill in VAULT_ROOT_TOKEN.
# This file holds ONLY the Vault root token and service ports — no secrets.
#
# After starting Vault, seed your API key directly into Vault:
#   docker-compose up -d vault
#   docker-compose exec vault vault kv put secret/llm/groq_api_key value=gsk_YOUR_KEY
#   docker-compose up

VAULT_ROOT_TOKEN=dev-root-token

# LLM API keys — seeded into Vault automatically on stack start
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# JWT signing key — seeded into Vault automatically on stack start
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Service ports
API_PORT=8000
MODELSERVER_PORT=8001
CHATBOT_PORT=8501
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200
JAEGER_PORT=16686
JAEGER_GRPC_PORT=4317
MLFLOW_PORT=5001
