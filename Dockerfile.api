FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv — fast Rust-based package installer
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# uv uses hardlinks by default — Docker build layers are read-only so we force copy mode
ENV UV_LINK_MODE=copy

COPY pyproject.toml .

# CPU-only torch first so uv resolves the lighter build (~200 MB vs ~2 GB CUDA)
RUN uv pip install --system --no-cache \
    torch==2.2.2+cpu \
    --extra-index-url https://download.pytorch.org/whl/cpu

RUN UV_HTTP_TIMEOUT=300 uv pip install --system --no-cache "setuptools>=68" wheel
RUN UV_HTTP_TIMEOUT=300 uv pip install --system --no-cache --no-build-isolation -e .

COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini ./alembic.ini
COPY prompts/ ./prompts/
COPY eval_thresholds.yaml ./eval_thresholds.yaml

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
