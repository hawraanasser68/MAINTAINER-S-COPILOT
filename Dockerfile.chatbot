FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv — fast Rust-based package installer
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy

COPY pyproject.toml .

# CPU-only torch (chatbot container needs sentence-transformers which depends on torch)
RUN uv pip install --system --no-cache \
    torch==2.2.2+cpu \
    --extra-index-url https://download.pytorch.org/whl/cpu

RUN UV_HTTP_TIMEOUT=300 uv pip install --system --no-cache "setuptools>=68" wheel
RUN UV_HTTP_TIMEOUT=300 uv pip install --system --no-cache --no-build-isolation -e .
RUN uv pip install --system --no-cache streamlit==1.39.0

COPY chatbot/ ./chatbot/
COPY app/infra/ ./app/infra/
COPY app/domain/ ./app/domain/
COPY prompts/ ./prompts/

EXPOSE 8501

CMD ["streamlit", "run", "chatbot/main.py", "--server.port=8501", "--server.address=0.0.0.0"]
