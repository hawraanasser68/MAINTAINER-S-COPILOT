FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv — fast Rust-based package installer
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy

COPY pyproject.toml .

# CPU-only torch first so uv resolves the lighter build (~200 MB vs ~2 GB CUDA)
RUN uv pip install --system --no-cache \
    torch==2.2.2+cpu \
    --extra-index-url https://download.pytorch.org/whl/cpu

RUN UV_HTTP_TIMEOUT=300 uv pip install --system --no-cache "setuptools>=68" wheel
RUN UV_HTTP_TIMEOUT=300 uv pip install --system --no-cache --no-build-isolation -e .

COPY modelserver/ ./modelserver/
COPY app/infra/ ./app/infra/
COPY app/domain/ ./app/domain/

EXPOSE 8001

CMD ["uvicorn", "modelserver.main:app", "--host", "0.0.0.0", "--port", "8001"]
